EMAIL_VERIFIER_URL=http://localhost:8080
# EMAIL_VERIFIER_SECRET=my-secret   # only if RCH__HEADER_SECRET is set on the backend
# EMAIL_VERIFIER_TIMEOUT_MS=60000

# --- Find Leads → Companies collector (all optional) ---------------------------
# Company Resolver search layer. With no key it uses the keyless DuckDuckGo
# scraper (through your proxy pool). Set a key to auto-upgrade to a SERP API.
# SEARCH_PROVIDER=serper           # serper | serpapi | brave  (default: serper)
# SEARCH_API_KEY=your-serp-api-key
# OpenCorporates legal-entity lookup. The free tier is heavily rate-limited and
# now returns 401 without a token; set one to enable real registry data.
# OPENCORPORATES_API_TOKEN=your-opencorporates-token

# Company crawler service (Find Leads → Companies)
CRAWLER_SERVICE_URL=http://localhost:8090
# LLM cross-check ("AI verify") runs INSIDE the crawler-service — set the
# DeepSeek key in crawler-service/.env, not here. Override the gateway timeout:
# CRAWLER_LLM_TIMEOUT_MS=300000
